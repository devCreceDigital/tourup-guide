---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import JsonLdPromptLanding from '../../../components/JsonLdPromptLanding.astro';
import SustainabilityTag from '../../../components/site/SustainabilityTag.astro';
import { getLocalizedString, type Locale } from '../../../utils/i18n';
import { cityLabel, companyRole } from '../../../utils/seo';
import {
  directoryStats,
  indexCompanies,
  isTranslated,
  mentionSignature,
  mentionSummary,
  placeholderSignatures,
  quickAnswer,
  resolveMentions,
} from '../../../utils/prompts';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  const promptsEs = await getCollection('prompts_es');
  return [
    ...prompts.map((prompt) => ({
      params: { lang: 'en', slug: prompt.id.replace(/[.]md$/i, "") },
      props: { prompt, lang: 'en' },
    })),
    ...promptsEs.map((prompt) => ({
      params: { lang: 'es', slug: prompt.id.replace(/[.]md$/i, "") },
      props: { prompt, lang: 'es' },
    })),
  ];
}

interface Props {
  prompt: any;
  lang: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

const { prompt, lang: langProp } = Astro.props;
const lang = langProp as Locale;
const es = lang === 'es';
const t = (esText: string, enText: string) => (es ? esText : enText);
const { Content } = await prompt.render();

const [companies, externalBrands, promptsEn, promptsEs, destinos] = await Promise.all([
  getCollection('companies'),
  getCollection('external_brands'),
  getCollection('prompts'),
  getCollection('prompts_es'),
  getCollection(es ? 'destinos' : 'destinos_en'),
]);

const resolvedBrands = resolveMentions(prompt.data.brands_ai_mentions, indexCompanies(companies), externalBrands, lang);
const foundBrands = resolvedBrands.filter((b) => b.found);
// La lista por defecto que comparten casi todos los prompts no es una mención real de la IA.
const placeholders = placeholderSignatures(
  (lang === 'es' ? promptsEs : promptsEn).map((p: any) => p.data.brands_ai_mentions ?? []),
);
const realMentions = !placeholders.has(mentionSignature(prompt.data.brands_ai_mentions));

const pageTitle = getLocalizedString(prompt.data.title, lang);
const slug = prompt.id.replace(/[.]md$/i, "");
const pagePath = `/${lang}/ai-prompts/${slug}/`;

// Las páginas /es/ son copias sin traducir del prompt en inglés: no se indexan ni se anuncian
// con hreflang hasta que tengan título propio en español.
const enTwin = promptsEn.find((p: any) => p.id === prompt.id);
const translated = !es || isTranslated(pageTitle, enTwin ? getLocalizedString(enTwin.data.title, 'en') : undefined);
const hasTwin = es ? !!enTwin : promptsEs.some((p: any) => p.id === prompt.id && isTranslated(getLocalizedString(p.data.title, 'es'), pageTitle));

// Un quick_answer escrito a mano manda; el texto de relleno "Landing page answering…" no cuenta.
const manualAnswer = getLocalizedString(prompt.data.quick_answer, lang).trim();
const answer = manualAnswer && !/^Landing page answering/i.test(manualAnswer)
  ? manualAnswer
  : quickAnswer({
      question: pageTitle,
      lang,
      mentions: resolvedBrands,
      realMentions,
      platforms: prompt.data.ai_platforms ?? [],
      stats: directoryStats(companies, lang, destinos),
    });

const destName = prompt.data.destination_cluster && !/^peru(_national)?$/i.test(prompt.data.destination_cluster)
  ? prompt.data.destination_cluster
  : t('Perú', 'Peru');

function generateFAQs(dest: string, cat: string): FAQItem[] {
  const dc = dest.toLowerCase();
  const faqs: FAQItem[] = [];

  if (dc.includes('machu picchu') || dc.includes('cusco') || dc.includes('inca')) {
    faqs.push({
      question: t(`¿Con cuánta antelación conviene reservar un tour en ${dest}?`, `How far in advance should I book a ${dest} tour?`),
      answer: t('Para temporada alta (junio–agosto) y permisos del Camino Inca se recomienda reservar con 4–6 meses de antelación. En temporada media suelen bastar 2–3 meses.', 'For high season dates (June–August) and Inca Trail permits, booking 4–6 months in advance is recommended. For shoulder season, 2–3 months is often enough.'),
    });
    faqs.push({
      question: t('¿Es mejor reservar con una empresa extranjera o con un operador peruano?', 'Is it better to book with a US-based company or a local Peruvian operator?'),
      answer: t('Las marcas extranjeras ofrecen atención y medios de pago conocidos; los operadores locales suelen dar itinerarios más flexibles y más conocimiento del terreno. Compara reseñas, servicios incluidos y precio total.', 'US-based brands can offer familiar customer service and payment options, while local operators may provide more flexible itineraries and better on-the-ground expertise. Many travelers compare both and choose based on reviews, inclusions, and overall value.'),
    });
  } else if (dc.includes('amazon')) {
    faqs.push({
      question: t(`¿Cuál es la mejor época para visitar ${dest}?`, `What is the best time to visit the ${dest}?`),
      answer: t('La estación seca (mayo–octubre) facilita ver fauna y tiene menos mosquitos; la húmeda (noviembre–abril) sube el nivel de los ríos para recorridos en bote.', 'The dry season (May–October) offers better wildlife spotting and fewer mosquitoes, while the wet season (November–April) has higher water levels for boat-based exploration.'),
    });
  } else {
    faqs.push({
      question: t(`¿Con cuánta antelación conviene reservar un tour en ${dest}?`, `How far in advance should I book a ${dest} tour?`),
      answer: t('Para destinos populares en temporada alta (junio–agosto) se recomienda reservar con 3–4 meses de antelación. En temporada media suele bastar 1–2 meses.', 'For popular destinations and peak season (June–August), booking 3–4 months in advance is recommended. For shoulder season, 1–2 months is often sufficient.'),
    });
    faqs.push({
      question: t(`¿Qué debo revisar al elegir una empresa de turismo en ${dest}?`, `What should I look for when choosing a ${dest} tour company?`),
      answer: t('Revisa que esté registrada (RUC y registro en MINCETUR), qué incluye el precio (entradas, comidas, alojamiento), el tamaño del grupo y la política de cancelación. Lee reseñas recientes de viajeros con un perfil parecido al tuyo.', 'Check that it is registered (RUC tax ID and MINCETUR record), what the price includes (permits, meals, accommodation), group size and the cancellation policy. Read recent reviews from travelers with a similar profile to yours.'),
    });
  }

  if (cat.includes('trekking') || cat.includes('hiking')) {
    faqs.push({
      question: t('¿Qué condición física exigen los tours de trekking?', 'What fitness level is required for trekking tours?'),
      answer: t('La mayoría exige una condición física moderada o alta, y los itinerarios en altura suelen incluir días de aclimatación.', 'Most trekking tours require moderate to high fitness levels. Some acclimatization days in high-altitude locations are typically included in itineraries.'),
    });
  }

  return faqs;
}

const faqItems = prompt.data.faq?.length
  ? (prompt.data.faq as FAQItem[])
  : generateFAQs(destName, prompt.data.category_cluster || '');

const listHeading = realMentions
  ? t('Empresas mencionadas en las respuestas de IA', 'Companies mentioned in AI answers')
  : t('Algunas empresas del directorio TourUp', 'Some companies in the TourUp directory');
const unresolved = resolvedBrands.filter((b) => !b.found);
// El cuerpo Markdown generado por el pipeline afirma que las empresas "son recomendadas por los
// modelos de IA" y "han sido evaluadas", sin dato que lo respalde, y repite la lista. De ese
// cuerpo solo se conservan los consejos de "Key Considerations", que sí cambian según el tema.
const rawBody = String(prompt.body ?? '').replace(/\r/g, '');
const generatedBody = /optimized for AI answer engines/i.test(rawBody);
const considerations = generatedBody
  ? (rawBody.match(/## Key Considerations\n([\s\S]*?)(?:\n\*Content generated|\n## |$)/)?.[1] ?? '')
      .split('\n')
      .map((l) => l.replace(/^\s*-\s*/, '').trim())
      .filter(Boolean)
  : [];
const checkedDate = prompt.data.last_ai_check_date ? new Date(prompt.data.last_ai_check_date) : null;
const validDate = checkedDate && !Number.isNaN(checkedDate.getTime()) ? checkedDate : null;
---

<Layout
  title={pageTitle}
  description={answer}
  currentPath={pagePath}
  lang={lang}
  date={prompt.data.last_ai_check_date}
  noindex={!translated || !realMentions}
  hreflang={translated && hasTwin}
>
  <JsonLdPromptLanding
    title={realMentions ? pageTitle : listHeading}
    brands={resolvedBrands}
    faqItems={faqItems}
    lang={lang}
    currentPath={pagePath}
  />

  <article class="prompt-landing">
    <header class="prompt-header">
      <h1>{pageTitle}</h1>
      {realMentions && prompt.data.ai_platforms?.length > 0 && (
        <div class="platforms">
          <strong>{t('Consultado en:', 'Checked on:')}</strong>
          {prompt.data.ai_platforms.map((platform: string) => (
            <span class="platform-badge">{platform}</span>
          ))}
        </div>
      )}
    </header>

    <section class="quick-answer">
      <h2>{t('Respuesta rápida', 'Quick answer')}</h2>
      <p>{answer}</p>
    </section>

    {foundBrands.length > 0 && (
      <section aria-label="Featured tour companies">
        <h2>{listHeading}</h2>
        <ol class="brands-grid">
          {foundBrands.map((m) => (
            <li class="brand-card">
              <h3>
                {m.external ? (
                  <a href={m.url} target="_blank" rel="noopener noreferrer">{m.entity!.data.name ?? m.name}</a>
                ) : (
                  <a href={m.url}>{m.name}</a>
                )}
              </h3>
              <p>{mentionSummary(m, lang)}</p>
              {!m.external && <SustainabilityTag companyId={m.entity!.id} lang={lang} />}
            </li>
          ))}
        </ol>
      </section>
    )}

    {foundBrands.some((m) => !m.external) && (
      <section aria-label="Comparison table">
        <h2>{t('Datos de las empresas', 'Company facts')}</h2>
        <table>
          <thead>
            <tr>
              <th>{t('Empresa', 'Company')}</th>
              <th>{t('Ciudad', 'City')}</th>
              <th>{t('Tipo', 'Type')}</th>
              <th>{t('Web', 'Website')}</th>
            </tr>
          </thead>
          <tbody>
            {foundBrands.filter((m) => !m.external).map((m) => {
              const d = m.entity!.data;
              const web = d.contact?.website;
              return (
                <tr>
                  <td><a href={m.url}><strong>{m.name}</strong></a></td>
                  <td>{cityLabel(d.location?.city ?? d.nap?.city) || '—'}</td>
                  <td>{companyRole(d, lang)}</td>
                  <td>{web ? <a href={web} target="_blank" rel="noopener noreferrer nofollow">{web.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a> : '—'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    )}

    {unresolved.length > 0 && (
      <section class="unresolved-brands">
        <h3>{t('Otras marcas citadas (sin ficha en el directorio)', 'Other brands cited (not in the directory)')}</h3>
        <ul>
          {unresolved.map((m) => (
            <li>{m.name}</li>
          ))}
        </ul>
      </section>
    )}

    <section aria-label={t('Cómo elegir una empresa de turismo', 'How to choose a tour company')}>
      <h2>{t(`Cómo elegir una empresa de turismo en ${destName}`, `How to choose a ${destName} tour company`)}</h2>
      <p>
        {t(
          'Al comparar operadores, fíjate en su seguridad, la calidad de los guías, el tamaño del grupo y lo claro que explican qué incluye el precio (entradas, trenes, porteadores, hoteles y comidas).',
          "When comparing operators, focus on safety records, guide quality, group size, and how clearly they communicate what's included (permits, trains, porters, hotels, and meals).",
        )}
      </p>
      <ul>
        <li>{t('Comprueba que su RUC y su registro en MINCETUR estén vigentes: aparecen en cada ficha del directorio.', 'Check that its RUC tax ID and MINCETUR registration are valid: both are shown on each directory profile.')}</li>
        <li>{t('Confirma que las entradas y permisos de los atractivos principales estén incluidos.', 'Confirm that permits and tickets for key attractions are included in the price.')}</li>
        <li>{t('Revisa en detalle la política de cancelación y cambios.', 'Review cancellation and rescheduling policies in detail.')}</li>
        <li>{t('Compara el tamaño del grupo y el tipo de alojamiento entre operadores.', 'Compare group size and accommodation standards across operators.')}</li>
      </ul>
    </section>

    {faqItems.length > 0 && (
      <section aria-label="Frequently asked questions">
        <h2>{t('Preguntas frecuentes', 'Frequently asked questions')}</h2>
        {faqItems.map((item: FAQItem) => (
          <article class="faq-item">
            <h3>{getLocalizedString(item.question as any, lang)}</h3>
            <p>{getLocalizedString(item.answer as any, lang)}</p>
          </article>
        ))}
      </section>
    )}

    {considerations.length > 0 && (
      <section class="prompt-content" aria-label={t('Qué tener en cuenta', 'Key considerations')}>
        <h2>{t('Qué tener en cuenta', 'Key considerations')}</h2>
        <ul>
          {considerations.map((c) => <li>{c}</li>)}
        </ul>
      </section>
    )}

    {!generatedBody && (
      <section class="prompt-content">
        <Content />
      </section>
    )}

    {validDate && (
      <footer class="prompt-footer">
        <p>
          <strong>{t('Última revisión:', 'Last checked:')}</strong>{' '}
          <time datetime={validDate.toISOString().slice(0, 10)}>{validDate.toLocaleDateString(es ? 'es-PE' : 'en-US')}</time>
        </p>
      </footer>
    )}
  </article>

  <nav class="prompt-nav">
    <a href={`/${lang}/ai-prompts/`} class="nav-link">{t('← Volver a los prompts', '← Back to prompts')}</a>
  </nav>
</Layout>

<style>
  .prompt-landing {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .prompt-header {
    border-bottom: 1px solid #e4e2e4;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .prompt-meta {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    background: #f0edef;
    color: var(--color-primary);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    border: 1px solid #e4e2e4;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .prompt-header h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #1b1b1d;
  }

  .search-term {
    color: #3e4851;
    margin: 1rem 0;
  }

  .platforms {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 1rem;
    color: #3e4851;
  }

  .platform-badge {
    display: inline-block;
    background: #f0edef;
    color: var(--color-primary);
    padding: 0.25rem 0.75rem;
    border-radius: 0.35rem;
    font-size: 0.85rem;
    border: 1px solid #e4e2e4;
    font-weight: 500;
  }

  .quick-answer {
    background: linear-gradient(135deg, rgba(0, 101, 145, 0.05) 0%, rgba(0, 180, 255, 0.05) 100%);
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .quick-answer h2 {
    margin-top: 0;
    color: var(--color-primary);
  }

  .quick-answer p {
    color: #3e4851;
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }

  .brand-card {
    background: #ffffff;
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    padding: 1.5rem;
    transition: border-color 0.15s ease;
  }

  .brand-card:hover {
    border-color: var(--color-primary);
  }

  .brand-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .brand-card a {
    color: var(--color-primary);
  }

  .brand-card a:hover {
    color: var(--color-primary-hover);
  }

  .brand-card p {
    color: #3e4851;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .brand-link {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.1s ease;
  }

  .brand-link:hover {
    color: var(--color-primary-hover);
  }

  .prompt-landing table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    background: #ffffff;
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .prompt-landing table th,
  .prompt-landing table td {
    padding: 0.85rem 1rem;
    text-align: left;
    border-bottom: 1px solid #e4e2e4;
    color: #3e4851;
    font-size: 0.9rem;
  }

  .prompt-landing table th {
    background: #f0edef;
    color: #1b1b1d;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.8rem;
  }

  .prompt-landing table tr:last-child td {
    border-bottom: none;
  }

  .prompt-landing table tr:hover td {
    background: #fcf8fb;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  .faq-item h3 {
    font-size: 1.05rem;
    color: #1b1b1d;
    margin-bottom: 0.6rem;
  }

  .faq-item p {
    color: #3e4851;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  section[aria-label^="How to choose"] ul {
    list-style: none;
    padding: 0;
  }

  section[aria-label^="How to choose"] li {
    padding: 0.5rem 0 0.5rem 1.5rem;
    position: relative;
    color: #3e4851;
    line-height: 1.6;
  }

  section[aria-label^="How to choose"] li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 600;
  }

  section[aria-label="Featured tour companies"] h2,
  section[aria-label="Comparison table"] h2,
  section[aria-label^="How to choose"] h2,
  section[aria-label="Frequently asked questions"] h2 {
    margin-bottom: 1.5rem;
    color: #1b1b1d;
  }

  .unresolved-brands {
    background: #ffffff;
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .unresolved-brands h3 {
    margin-top: 0;
    color: #1b1b1d;
  }

  .unresolved-brands ul {
    list-style: none;
    padding: 0;
  }

  .unresolved-brands li {
    padding: 0.5rem 0;
    border-bottom: 1px solid #e4e2e4;
    color: #3e4851;
  }

  .unresolved-brands li:last-child {
    border-bottom: none;
  }

  .prompt-content {
    margin: 2rem 0;
    font-size: 1rem;
    line-height: 1.8;
    color: #3e4851;
  }

  .prompt-content :global(h2) {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem 0;
    color: #1b1b1d;
  }

  .prompt-content :global(p) {
    margin-bottom: 1rem;
  }

  .prompt-footer {
    border-top: 1px solid #e4e2e4;
    padding-top: 1.5rem;
    margin-top: 2rem;
    color: #6e7882;
    font-size: 0.9rem;
  }

  .prompt-nav {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e4e2e4;
  }

  .prompt-nav .nav-link {
    color: var(--color-primary);
    font-weight: 600;
    transition: padding-left 0.1s ease;
  }

  .prompt-nav .nav-link:hover {
    padding-left: 0;
    color: var(--color-primary-hover);
  }

  @media (max-width: 768px) {
    .prompt-header h1 {
      font-size: 1.5rem;
    }

    .brands-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
