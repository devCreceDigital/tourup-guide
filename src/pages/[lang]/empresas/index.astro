---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getLocalizedString } from '../../../utils/i18n';
import { companyDisplayName, hasCompanyName } from '../../../utils/seo';
import SustainabilityTag from '../../../components/site/SustainabilityTag.astro';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' }, props: { lang: 'es' } }];
}

interface Props { lang: string; }
const { lang } = Astro.props;
const loc = (field: any) => getLocalizedString(field, lang);

// Solo fichas con nombre real: las 9 sin nombre son noindex y no cuentan en las cifras del sitio.
const companies = (await getCollection('companies')).filter((c) => hasCompanyName(loc(c.data.title)));

const grouped = companies.reduce<Record<string, typeof companies>>((acc, c) => {
  const titleStr = typeof c.data.title === 'string' ? c.data.title : (c.data.title?.en || c.data.title?.es || c.id);
  const first = titleStr.charAt(0).toUpperCase();
  if (!/[A-Za-z0-9]/.test(first)) {
    acc['#'] = acc['#'] || [];
    acc['#'].push(c);
  } else {
    acc[first] = acc[first] || [];
    acc[first].push(c);
  }
  return acc;
}, {});

const letters = Object.keys(grouped).sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

const totalDestinos = new Set(companies.flatMap(c => c.data.destinos || [])).size;
const currentPath = `/${lang}/empresas/`;
---

<Layout
  title="Directorio de Empresas Turísticas en Perú – TourUp"
  description={`Directorio completo de ${companies.length} prestadores de servicios turísticos en Perú. Encuentra operadores, agencias y DMCs registrados, cada uno con su RUC.`}
  currentPath={currentPath}
  lang={lang}
>
  <div class="page-header">
    <h1>Directorio de Empresas <span class="highlight">Turísticas</span></h1>
    <p class="subtitle">
      {companies.length} prestadores de servicios turísticos registrados en Perú
      &middot; {totalDestinos} destinos cubiertos
    </p>
  </div>

  <div class="letter-nav">
    {letters.map(l => (
      <a href={`#letter-${l}`} class="letter-jump">{l}</a>
    ))}
  </div>

  <div class="directory">
    {letters.map(l => (
      <section id={`letter-${l}`} class="letter-section">
        <h2 class="letter-heading">{l} <span class="count">({grouped[l].length})</span></h2>
        <div class="company-grid">
          {grouped[l].map(c => (
            <a href={`/${lang}/empresas/${c.id.replace(/\.md$/i, '')}/`} class="company-card">
              <h3 class="company-name">{companyDisplayName(c.data, lang as 'es' | 'en') || c.id}</h3>
              {c.data.summary && (
                <p class="company-summary">{loc(c.data.summary)}</p>
              )}
              <div class="company-meta">
                {c.data.location?.city && (
                  <span class="tag location">{loc(c.data.location.city)}</span>
                )}
                {c.data.distribution_role && (
                  <span class="tag role">{c.data.distribution_role.replace(/_/g, ' ')}</span>
                )}
                <SustainabilityTag companyId={c.id} lang={lang as 'es' | 'en'} />
                {c.data.rating && (
                  <span class="tag rating">★ {c.data.rating}</span>
                )}
              </div>
            </a>
          ))}
        </div>
        <a href="#" class="back-top">↑ Volver arriba</a>
      </section>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid #e4e2e4;
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #1b1b1d;
  }
  .page-header .highlight {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .subtitle {
    color: #6e7882;
    font-size: 1.1rem;
  }
  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: #f0edef;
    border-radius: 0.75rem;
    border: 1px solid #e4e2e4;
    position: sticky;
    top: 80px;
    z-index: 50;
  }
  .letter-jump {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #3e4851;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
  }
  .letter-jump:hover {
    background: rgba(0, 101, 145, 0.1);
    color: var(--color-primary);
  }
  .letter-section {
    margin-bottom: 2rem;
    scroll-margin-top: 140px;
  }
  .letter-heading {
    font-size: 1.75rem;
    color: #1b1b1d;
    border-bottom: 2px solid rgba(0, 101, 145, 0.2);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }
  .letter-heading .count {
    font-size: 1rem;
    color: #6e7882;
    font-weight: 400;
  }
  .company-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }
  .company-card {
    display: block;
    background: #ffffff;
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    padding: 1.25rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .company-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }
  .company-name {
    font-size: 1rem;
    color: #1b1b1d;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .company-summary {
    font-size: 0.85rem;
    color: #3e4851;
    margin-bottom: 0.75rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .company-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-weight: 500;
  }
  .tag.location {
    background: rgba(0, 101, 145, 0.1);
    color: var(--color-primary);
  }
  .tag.role {
    background: rgba(0, 101, 145, 0.08);
    color: var(--color-primary-hover);
    text-transform: capitalize;
  }
  .tag.rating {
    background: rgba(251, 191, 36, 0.15);
    color: #b8860b;
  }
  .back-top {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #6e7882;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-top:hover {
    color: var(--color-primary);
  }
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.75rem;
    }
    .company-grid {
      grid-template-columns: 1fr;
    }
    .letter-nav {
      gap: 0.25rem;
      padding: 0.75rem;
      top: 60px;
    }
    .letter-jump {
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.75rem;
    }
  }
</style>
